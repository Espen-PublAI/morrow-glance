# These variables are read by the Cloudflare runtime. Locally, put them in
# `.dev.vars` (see .dev.vars.example); in production set them as Worker secrets.

# Used to build absolute social-preview URLs in production.
MORROW_PUBLIC_URL=http://localhost:3000

# Required for Admin writes outside localhost. Keep this secret.
MORROW_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional. Set to the git SHA at deploy time so open Players reload after a deploy.
# MORROW_BUILD_ID=

# Required for webhook data sources. Systems that push data send it as
# `Authorization: Bearer <token>` or `x-morrow-token: <token>`.
MORROW_WEBHOOK_TOKEN=replace-with-a-webhook-token

# Microsoft 365 calendar plugin: an Entra app registration with the Graph
# application permission Calendars.Read. See plugins/calendar/README.md.
MORROW_MS_TENANT_ID=
MORROW_MS_CLIENT_ID=
MORROW_MS_CLIENT_SECRET=

# GitHub plugin: optional. A fine-grained personal access token used for every
# GitHub block that has no token of its own. Needed for contribution heatmaps
# and strongly recommended on Cloudflare, where the unauthenticated limit is
# shared with other tenants. See plugins/github/README.md.
MORROW_GITHUB_TOKEN=
